{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-template",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-template-library",
      "database_id": "97524c96-2ffa-4278-8741-57773de28b99",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  // OpenAI-compatible AI proxies in this account: no OpenRouter key in this Worker.
  // Hyphenated names are read with bracket access in the Worker (env["AI-PROXY"]).
  "unsafe": {
    "bindings": [
      { "name": "AI-PROXY", "type": "service", "service": "ai-proxy", "environment": "production" },
      { "name": "ORPROXY", "type": "service", "service": "orproxy", "environment": "production" },
      // The agents. No "entrypoint": an entrypointed binding to PiAgent/QCLogger
      // cannot be fetched or called over RPC, and every request 500s.
      { "name": "PI-H", "type": "service", "service": "pi-harness-example", "environment": "production" },
      { "name": "TRUTH", "type": "service", "service": "truth", "environment": "production" }
    ]
  },
  "browser": {
    "binding": "BROWSER"
  },
  "vars": {
    "AI_DAILY_LIMIT": "60",
    "AI_MODELS": "openai/gpt-4o-mini,google/gemini-2.5-flash,anthropic/claude-sonnet-4.5,qwen/qwen2.5-vl-72b-instruct,openai/gpt-5-nano,openai/gpt-4.1-nano,google/gemini-2.5-flash-lite,scaledown/extract,scaledown/summarize,inference-net/schematron-v2-turbo,meta-llama/llama-3.1-8b-instruct,deepseek/deepseek-v4.1-flash-1017",
    // orproxy / OpenRouter. Set ORPROXY_API_KEY as a Worker secret; without it the
    // Worker falls back to Workers AI. Point ORPROXY_URL at your own proxy if it differs.
    "ORPROXY_URL": "https://openrouter.ai/api/v1",
    "ORPROXY_MODEL": "openai/gpt-4o-mini"
  }
  // A Cloudflare service binding named AI_PROXY also works, and is used before
  // the URL: it must answer POST /chat/completions in the OpenAI format.
  // "services": [{ "binding": "AI_PROXY", "service": "your-ai-proxy" }]
}
