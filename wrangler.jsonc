{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-template-library",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-template-library",
      "database_id": "97524c96-2ffa-4278-8741-57773de28b99",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "AI_DAILY_LIMIT": "20"
  }
  // Optional: run AI help on Cloudflare Workers AI instead of an OpenAI key.
  // "ai": { "binding": "AI" },
  // Optional: set AI_MODEL / OPENAI_BASE_URL here; keep keys in `wrangler secret`.
}
