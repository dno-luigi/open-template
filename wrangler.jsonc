{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-template-library",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-template-library",
      "database_id": "97524c96-2ffa-4278-8741-57773de28b99",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AI_DAILY_LIMIT": "20"
  }
  // AI runs on Cloudflare Workers AI. To use an OpenAI-compatible provider instead,
  // remove the "ai" binding above and set OPENAI_API_KEY (plus AI_MODEL / OPENAI_BASE_URL).
}
